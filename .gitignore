# Release allowlist for the reference harness repository.
# Root entries are ignored unless explicitly allowed below.
/*
!/.agents/
!/.cursor/
!/.codex/
!/.kilo/
!/.qoder/
!/.qwen/
!/.dsh/
!/.serena/
!/.tools/
!/.doc/
!/AGENTS.md
!/mcp.index.md
!/.cbmignore
!/.codeprism.toml
!/kilo.json
!/DSH-RULES.md
!/EXPORT_NEXT_STEPS.md
!/.gitignore

# Local credentials and machine values. Examples stay tracked.
*.mcp.env
/.agents/mcp.env
/.cursor/mcp.env
/.codex/mcp.env
/.kilo/mcp.env
/.doc/web/.env
**/config.env
*.local.md
*.local.json
*.local.yaml
*.local.yml
*.local.*
!*.local.example.*
!*.example.*
!/.agents/skills/prepare-plan/ADAPTERS.local.md
!/.agents/skills/harness-router/children/index/references/ADAPTERS.local.md
!/.agents/skills/harness-router/children/mirror/references/ADAPTERS.local.md
!/.doc/web/ADAPTERS.local.md

# CopyTrust workspace helpers contain project-specific credentials and are
# not part of the portable harness. Keep them local until sanitized or moved.
/.agents/skills/harness-router/children/new-project/scripts/create-workspace.sh
/.agents/skills/harness-router/children/new-project/scripts/create-isolated-workspace.sh

# Local state, backups and generated reports.
# Project-specific documentation is never part of the universal harness.
/.doc/architecture/
/.doc/tasks/
/.doc/archive/
/.doc/qa/flows/
/.doc/qa/_map/
/.doc/qa/eslint/
/.doc/.rebase-*
/.doc/.rebase-backup/
/.doc/.rebase-conflicts.json
/.doc/.rebase-kit.json
/.doc/skil_data/
/.doc/temp/
/.doc/tmp/
/.doc/web/state/
/.doc/web/*.log
/.doc/harnes/astra_plan/
/.doc/harnes/audit/
/.doc/harnes/state/.validate-rules-last.json

# Generated views and caches are rebuilt by the trusted renderer.
/.kilo/kilo-permissions.fragment.jsonc
/.kilo/rules-index.md
/.codex/rules-index.md
# Generated adapter settings and configs (restored by environment sync).
/.qoder/settings.json
/.qwen/settings.json
/.kilo/kilo.jsonc
/.codex/config.toml
/.codex/mcp.json
/.kilo/mcp.json
/.agents/rules/
/.agents/mcp.json
/.agents/mcp_config.json
/.agents/skills.json
/.codex/rules/
/.codex/skills/
/.codex/mcp.json
/.kilo/rules/
/.kilo/mcp.json
/.qoder/skills/
/.qoder/rules/
/.qwen/skills/
/.qwen/rules/
/.dsh/skills/
/.serena/memories/
/.serena/cache/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dependencies, vendor trees and local environments.
**/*.phar
**/node_modules/
**/vendor/
**/venv/
**/.venv/
**/.venv-*/
**/dist/
**/build/
**/cache/
**/logs/
**/*.log
php_error.log
.playwright-mcp/
**/*.tmp
**/*.bak
**/*.orig
**/*.rej
