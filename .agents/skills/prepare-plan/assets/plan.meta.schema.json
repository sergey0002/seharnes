{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prepare-plan authored Markdown metadata",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["task-plan", "plan", "flow"] },
    "task": { "type": "string", "pattern": "^.+$" },
    "status": { "type": "string", "enum": ["draft", "ready", "implemented"] },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of the last plan edit, project documentation standard"
    },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relative links to the task brief, architecture docs and test canon"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Project tag vocabulary, plan tag included"
    },
    "audit_status": { "type": "string", "enum": ["pending", "passed", "failed", "blocked"] },
    "plan_rev": {
      "type": "integer",
      "minimum": 1,
      "description": "Author-owned plan revision. Any content edit by the author increments it."
    },
    "audit_passes": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of rows in the plan audit journal"
    },
    "last_audit": {
      "type": "string",
      "description": "Date of the last audit pass, or none"
    },
    "task_closure": { "type": "string", "pattern": "^(100|[1-9]?[0-9])%$" },
    "research_complete": { "type": "boolean" },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "scope_size": {
      "type": "string",
      "enum": ["trivial", "small", "medium", "large"],
      "description": "P3.5 proportional decomposition size"
    }
  },
  "required": ["type", "task", "status", "updated", "scope_size", "audit_status", "plan_rev", "task_closure"],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
      "then": {
        "properties": {
          "audit_status": { "const": "passed" },
          "audit_passes": { "type": "integer", "minimum": 1 },
          "last_audit": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "required": ["audit_passes", "last_audit"]
      }
    },
    {
      "if": { "anyOf": [
        { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
        { "properties": { "audit_status": { "const": "passed" } }, "required": ["audit_status"] }
      ] },
      "then": {
        "properties": { "task_closure": { "const": "100%" } },
        "allOf": [{
          "if": { "anyOf": [
            { "properties": { "scope_size": { "enum": ["medium", "large"] } }, "required": ["scope_size"] },
            { "properties": { "risk_level": { "enum": ["high", "critical"] } }, "required": ["risk_level"] }
          ] },
          "then": { "required": ["research_complete"], "properties": { "research_complete": { "const": true } } }
        }]
      }
    }
  ],
  "additionalProperties": true
}
