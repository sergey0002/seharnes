{
  "$schema": "internal:jsondoc#tags",
  "title": "JSONdoc tag dictionary v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "tags"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "revision": {"type": "integer", "minimum": 1},
    "tags": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "label", "description", "aliases",
                     "parents", "status", "replaced_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]+:[a-z0-9-]+$"},
          "kind": {"enum": ["type", "domain", "process", "component", "technology", "risk"]},
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "parents": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z]+:[a-z0-9-]+$"}
          },
          "status": {"enum": ["active", "deprecated"]},
          "replaced_by": {"type": ["string", "null"]}
        }
      }
    }
  }
}
