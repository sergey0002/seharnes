{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todone.local/schemas/workspace-marker-1.json",
  "title": "WORKSPACE-1 explicit aggregate child marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workspace_id"],
  "properties": {
    "schema": {"const": "WORKSPACE-1"},
    "workspace_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string"},
    "parent": {"type": ["string", "null"]},
    "docs_path": {"type": "string", "minLength": 1},
    "aggregate": {"type": "boolean"},
    "queues": {"type": "array", "items": {"type": "string"}},
    "excludes": {"type": "array", "items": {"type": "string"}},
    "product_id": {"type": "string"},
    "policy": {"type": "object"}
  }
}
