{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todone.local/schemas/autodoc-source-1.json",
  "title": "AUTODOC-SOURCE-1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "source_id",
    "canonical_path",
    "source_domain",
    "media_type",
    "byte_size",
    "sha256",
    "mode_policy",
    "redaction",
    "classification",
    "source_of_truth",
    "generated",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "AUTODOC-SOURCE-1"
    },
    "source_id": {
      "type": "string"
    },
    "canonical_path": {
      "type": "string"
    },
    "source_domain": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string"
    },
    "mode_policy": {
      "type": "string"
    },
    "raw": {},
    "raw_encoding": {
      "type": "string"
    },
    "redaction": {
      "type": "object",
      "additionalProperties": true
    },
    "classification": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "boolean"
    },
    "generated": {
      "type": "boolean"
    },
    "provenance": {
      "type": "array",
      "items": {}
    },
    "external": {
      "type": "boolean"
    },
    "raw_available": {
      "type": "boolean"
    },
    "text_encoding": {
      "type": "string"
    }
  }
}
