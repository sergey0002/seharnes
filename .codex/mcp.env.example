# Copy to mcp.env and edit for this project only.
# setup.ps1 can sync MYSQL_* from .tools/docker-dev/.env (Docker port mapping).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=8031
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=gb_copydev5

# Docker dev (copytrust): sync with .tools/docker-dev/.env
# APACHE http://localhost:8030  →  MySQL host port MYSQL_PORT (8031)
# Database name = MYSQL_DATABASE from docker-dev (.env), usually gb_copydev5
# Do NOT use host:3306 — that is often another container on the machine.

# Optional: PHP binary (otherwise "php" from PATH, else setup sets php-docker.cmd)
# PHP_BIN=
# DOCKER_PHP_CONTAINER=copytrust-dev-php-apache-1

# Optional: Node.js for phpstan-mcp / php-deps-mcp (WSL: ~/.local/bin/node via node-mcp.sh)
# NODE_BIN=/home/newuser/.local/bin/node

# Optional: codebase-memory-mcp UI port / tmux session (defaults: 9749 / cbm-ui)
# CBM_UI_PORT=9749
# CBM_UI_TMUX_SESSION=cbm-ui

# Optional: Laragon root if PHP is not on PATH
# LARAGON_ROOT=
# Local Sourcegraph MCP (sourcegraph-local/, port 7080)
# Запуск: cd sourcegraph-local && ./start-single.sh
# После site-admin/init: Settings → Access tokens → scope mcp
# Токен: для Cursor HTTP MCP — полная строка Authorization в .cursor/mcp.json
# (envFile не подхватывается для type:http; ${env:...} — только OS env при старте Cursor)
# Для Codex: SOURCEGRAPH_MCP_TOKEN=sgp_local_... (без префикса token)
